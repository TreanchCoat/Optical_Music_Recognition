# OMR Pipeline configuration (local — gitignored)
# See .env.example for documentation of every supported variable.

# ─── Model files ─────────────────────────────────────────────────────
MODEL_PATH=S:\omr\models\deepscores54.pt
OLA_MODEL_PATH=S:\omr\models\ola_v2.pt
UNET_MODEL_PATH=S:\omr\models\staff_unet.pth

# ─── API server ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
MAX_IMAGE_MB=50

# ─── Pipeline output base (per-job folders are created underneath) ───
OUTPUT_BASE_DIR=S:\omr\output

# ─── Dummy-API fixtures ──────────────────────────────────────────────
DUMMY_RECTIFIED_PATH=S:\omr\data\sample\rectified.png
DUMMY_XML_PATH=S:\omr\data\sample\score.xml
DUMMY_DETECTIONS_PATH=S:\omr\data\sample\detections.json

OMR_NUM_PARTS=3